{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gestor-proyectos/browser",
  "git": { "deploymentEnabled": false },
  "rewrites": [{ "source": "/((?!ngsw-worker\\.js|ngsw\\.json|manifest\\.webmanifest|icons/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    { "source": "/ngsw-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/ngsw.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
